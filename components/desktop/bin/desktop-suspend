#!/usr/bin/env python3
"""Optional, focused manual-suspend countdown; never changes idle or button policy."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import uuid

APP_ID = "org.niri-plus.suspend"


def log(message):
    print("desktop-suspend: " + message, flush=True)


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError("countdown state must be a private, owned directory")
    return path


def state_directory(environment=None):
    env = os.environ if environment is None else environment
    runtime = Path(env.get("XDG_RUNTIME_DIR", ""))
    session = env.get("NIRI_SOCKET", "")
    if not runtime.is_absolute() or not session:
        raise RuntimeError("the captured Niri session and XDG_RUNTIME_DIR are required")
    private_directory(runtime)
    parent = private_directory(runtime / "niri-plus-suspend")
    identity = hashlib.sha256(session.encode()).hexdigest()[:16]
    return private_directory(parent / identity)


def atomic_json(path, data):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
            temporary = Path(stream.name)
            json.dump(data, stream)
            stream.write("\n")
        temporary.replace(path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


class Session:
    """An instance owner plus a short transition lock serialize cancel and commit.

    Cancellation writes the active instance token, including while GTK is still
    importing. The token is checked again under the transition lock immediately
    before any power action; no process IDs or arbitrary signals are needed.
    """
    def __init__(self, directory):
        self.directory = private_directory(directory)
        self.token = uuid.uuid4().hex
        self.owner = None
        self.pending = directory / "pending.json"
        self.cancellation = directory / "cancel.json"

    def open_lock(self, name):
        fd = os.open(self.directory / name, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            os.close(fd)
            raise RuntimeError("invalid countdown lock")
        return fd

    @contextmanager
    def gate(self):
        fd = self.open_lock("transition.lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(fd)

    def begin(self):
        with self.gate():
            fd = self.open_lock("owner.lock")
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                return False
            self.owner = fd
            self.cancellation.unlink(missing_ok=True)
            atomic_json(self.pending, {"token": self.token, "phase": "pending"})
        return True

    def cancel(self):
        with self.gate():
            probe = self.open_lock("owner.lock")
            try:
                try:
                    fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    pending = read_json(self.pending)
                    if not isinstance(pending, dict) or not isinstance(pending.get("token"), str):
                        raise RuntimeError("active countdown state is invalid")
                    atomic_json(self.cancellation, {"token": pending["token"]})
                    return True
                # An interrupted previous instance cannot leave a pending timer.
                self.pending.unlink(missing_ok=True)
                self.cancellation.unlink(missing_ok=True)
                return False
            finally:
                os.close(probe)

    def cancelled(self):
        pending = read_json(self.pending)
        cancellation = read_json(self.cancellation)
        return (not isinstance(pending, dict) or pending.get("token") != self.token
                or cancellation == {"token": self.token})

    def commit(self, *, run=subprocess.run, config_home=None):
        with self.gate():
            if self.cancelled():
                return False
            # The independent native policy remains authoritative for locking.
            policy = Path(config_home or os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
            data = tomllib.loads((policy / "desktop-session/power.toml").read_text())
            lock = data["lock_before_suspend"]
            if not isinstance(lock, bool):
                raise ValueError("lock_before_suspend must be a TOML boolean")
            atomic_json(self.pending, {"token": self.token, "phase": "committing"})
            if lock:
                run(["systemctl", "--user", "start", "desktop-lock.service"], check=True, timeout=15)
            run(["systemctl", "suspend"], check=True, timeout=30)
            return True

    def close(self):
        if self.owner is None:
            return
        try:
            with self.gate():
                pending = read_json(self.pending)
                if isinstance(pending, dict) and pending.get("token") == self.token:
                    self.pending.unlink(missing_ok=True)
                    self.cancellation.unlink(missing_ok=True)
        finally:
            os.close(self.owner)
            self.owner = None


class Countdown:
    """Count visible, focused time only; delayed or resumed UI cancels safely."""
    def __init__(self, seconds, *, clock=time.monotonic, boot_clock=None):
        self.seconds = seconds
        self.clock = clock
        self.boot_clock = boot_clock or (lambda: time.clock_gettime(time.CLOCK_BOOTTIME))
        self.created = clock()
        self.started = None
        self.last = None
        self.last_boot = None
        self.outcome = None

    def cancel(self):
        if self.outcome is None:
            self.outcome = "cancelled"

    def tick(self, focused, cancelled=False):
        if self.outcome is not None:
            return 0
        now, boot = self.clock(), self.boot_clock()
        if cancelled or (self.started is not None and not focused):
            self.cancel()
        elif self.started is None:
            if focused:
                self.started, self.last, self.last_boot = now, now, boot
            elif now - self.created >= 3:
                self.cancel()
        elif now - self.last > 2 or abs((boot - self.last_boot) - (now - self.last)) > 0.5:
            self.cancel()
        else:
            self.last, self.last_boot = now, boot
            if now - self.started >= self.seconds:
                self.outcome = "elapsed"
        return self.seconds if self.started is None else max(0, math.ceil(self.seconds - (now - self.started)))


def show_countdown(session, seconds, label):
    # Keep cancellation/away commands usable without importing any UI library.
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import GLib
    GLib.set_prgname(APP_ID)
    from gi.repository import Gdk, Gtk
    ready, _ = Gtk.init_check(None)
    display = Gdk.Display.get_default()
    if not ready or display is None or display.__gtype__.name != "GdkWaylandDisplay":
        raise RuntimeError("a live Wayland display is required for the countdown")
    window = Gtk.Window(title="Suspend " + label)
    window.set_resizable(False)
    window.set_decorated(False)
    window.set_default_size(460, -1)
    window.set_modal(True)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    box.set_border_width(24)
    title = Gtk.Label(label="")
    title.get_style_context().add_class("title")
    hint = Gtk.Label(label="Esc to cancel")
    button = Gtk.Button.new_with_label("Cancel")
    for widget in (title, hint, button):
        box.pack_start(widget, False, False, 0)
    window.add(box)
    timer = Countdown(seconds)
    finished = False
    previous = None

    def finish():
        nonlocal finished
        if finished:
            return
        finished = True
        window.destroy()
        Gtk.main_quit()

    def cancel(*_):
        timer.cancel()
        finish()
        return True

    def active(*_):
        if timer.started is not None and not finished and not window.is_active():
            cancel()

    def key(_window, event):
        if event.keyval == Gdk.KEY_Escape or (event.keyval == Gdk.KEY_g and event.state & Gdk.ModifierType.CONTROL_MASK):
            return cancel()
        # Enter can only activate Cancel; it never skips the countdown.
        return False

    def tick():
        nonlocal previous
        try:
            remaining = timer.tick(window.get_mapped() and window.is_active(), session.cancelled())
        except (OSError, ValueError, TypeError):
            return cancel() and False
        if timer.outcome is not None:
            finish()
            return False
        if remaining != previous:
            title.set_text(f"{label} will suspend in {remaining} seconds")
            log("countdown: " + str(remaining))
            previous = remaining
        return True

    window.connect("delete-event", cancel)
    window.connect("key-press-event", key)
    window.connect("notify::is-active", active)
    button.connect("clicked", cancel)
    Gdk.Display.get_default().connect("closed", cancel)
    sources = [GLib.timeout_add(100, tick)]
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        sources.append(GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, cancel))
    try:
        title.set_text(f"{label} will suspend in {seconds} seconds")
        window.show_all()
        window.present()
        Gtk.main()
        return timer.outcome == "elapsed"
    finally:
        for source in sources:
            if GLib.MainContext.default().find_source_by_id(source):
                GLib.source_remove(source)
        window.destroy()


def away(session, lock=False, *, run=subprocess.run):
    session.cancel()
    if lock:
        run(["systemctl", "--user", "start", "desktop-lock.service"], check=True, timeout=15)
    run(["desktop-away", "away"], check=True, timeout=10)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("countdown", "cancel", "away"))
    parser.add_argument("--seconds", type=int, default=5)
    parser.add_argument("--label", default=socket.gethostname())
    parser.add_argument("--lock", action="store_true", help="Lock before the away action")
    args = parser.parse_args(argv)
    if not 1 <= args.seconds <= 60:
        parser.error("--seconds must be between 1 and 60")
    label = "".join(character for character in args.label if character.isprintable()).strip()[:64]
    session = None
    try:
        session = Session(state_directory())
        if args.action == "cancel":
            log("pending countdown cancelled" if session.cancel() else "no pending countdown")
        elif args.action == "away":
            away(session, args.lock)
        else:
            ready = Path(__file__).resolve().with_name("desktop-session-ready")
            subprocess.run([str(ready)], check=True, timeout=3)
            if not session.begin():
                log("a countdown is already pending")
                return 0
            if show_countdown(session, args.seconds, label or "This computer") and session.commit():
                log("suspend requested")
            else:
                log("suspend cancelled")
        return 0
    except (OSError, RuntimeError, ValueError, KeyError, ImportError, subprocess.SubprocessError) as error:
        print("desktop-suspend: suspend cancelled: " + str(error), file=sys.stderr)
        return 1
    finally:
        if session is not None:
            session.close()


if __name__ == "__main__":
    raise SystemExit(main())
