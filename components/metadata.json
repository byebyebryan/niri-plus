    },
    {
      "path": "examples/session/desktop-session-ready",
      "component": "components/desktop/bin/desktop-session-ready",
      "notes": "This download and the desktop utility download share one source component."
    },
    {
      "path": "examples/session/polkit-session.conf",
      "component": "components/desktop/systemd/user/plasma-polkit-agent.service.d/session.conf"
    },
    {
      "path": "examples/session/profiles/minimal-niri/desktop-lock.service",
      "component": "components/desktop/systemd/user/desktop-lock.service",
      "profile": "minimal-niri",
      "notes": "Selected Gtklock service; the authored portable unit remains at the existing example path."
    },
    { "path": "examples/terminal/THIRD_PARTY_NOTICES.md", "component": "components/shell/THIRD_PARTY_NOTICES.md" },
    { "path": "examples/terminal/fetch.py", "component": "components/shell/fetch.py" },
    { "path": "examples/terminal/init.zsh", "component": "components/shell/init.zsh" },
    { "path": "examples/terminal/p10k-custom-segments.zsh", "component": "components/shell/p10k-custom-segments.zsh" },
    { "path": "examples/terminal/p10k.zsh", "component": "components/shell/p10k.zsh" },
    { "path": "examples/terminal/pins.json", "component": "components/shell/pins.json" },
    { "path": "examples/terminal/zshrc", "component": "components/shell/zshrc" }
  ],
  "appearance_exports": [
    {
      "path": "examples/theme/NeutralSlate.colors",
      "artifact": "NeutralSlate.colors",
      "notes": "Generated KDE color groups; keep unrelated kdeglobals groups and font preferences. not a deployed artifact."
    },
    {
