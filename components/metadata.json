    {
      "path": "examples/theme/niri-neutral-slate.kdl",
      "artifact": "niri-neutral-slate.kdl",
      "notes": "Canvas and focus-ring appearance fragment for the existing Niri layout block. not a deployed artifact."
    },
    {
      "path": "examples/theme/qt5-palette.conf",
      "artifact": "qt5-palette.conf",
      "notes": "Qt 5 QPalette colors only; style and dialog preferences remain separately owned. not a deployed artifact."
    },
    {
      "path": "examples/theme/qt6-palette.conf",
      "artifact": "qt6-palette.conf",
