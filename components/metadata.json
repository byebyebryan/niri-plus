{
  "version": "0.5.0",
  "modules": {
    "desktop": {
      "prerequisites": [
        "Linux with a Wayland graphical session",
        "systemd --user for the reusable service units",
        "Python 3.11 or newer for the Python helpers",
        "Rofi 2.0 for direct Network, Audio and Bluetooth controls",
        "PyGObject with NetworkManager/libnm and libsecret introspection for Network; BlueZ D-Bus for Bluetooth",
        "pactl and an existing PulseAudio-compatible server for Audio; existing native owners are not installed or started by a menu",
        "For opt-in away mode: libwayland-client and ext-idle-notify v2, or existing read access to physical evdev input"
      ]
    },
    "shell": {
      "prerequisites": [
        "Zsh 5.8 or newer for the shell core",
        "Python 3.10 or newer for the opt-in dependency fetcher",
        "Linux proc/sys interfaces are optional; missing inputs hide their prompt segments",
        "GitHub codeload access is needed only when the fetcher is run"
      ]
    },
    "appearance": {
      "prerequisites": [
        "Python 3.11 or newer for schema-2 appearance rendering and SDDM derivation",
        "An unpacked, separately pinned SDDM theme tree is required only for greeter derivation"
      ]
    }
  },
