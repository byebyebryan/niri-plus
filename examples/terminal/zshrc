# Niri Plus portable Zsh core. Source this file from your own .zshrc after
# reviewing the recipe; this file never edits shell startup files by itself.

# The bundle is relocatable and keeps its plugins beside this file.
typeset -g NIRI_PLUS_ZSH_HOME="${${(%):-%x}:A:h}"

# Agent tool shells use a hostname-only prompt and return before history,
# completion, plugins, integrations, or the refresh watcher are initialized.
_niri_plus_is_agent_shell() {
  [[ -n "${ZSH_FORCE_FULL_PROMPT:-}" ]] && return 1
  [[ -n "${ZSH_FORCE_SIMPLE_PROMPT:-}" ]] && return 0

  local terminal_program="${TERM_PROGRAM:l}"
  local -a markers=(
    NIRI_PLUS_AGENT_TOOL
    CODEX_CI CODEX_THREAD_ID
    CLAUDE_PROJECT_DIR CLAUDE_ENV_FILE CLAUDE_CODE_REMOTE
    GEMINI_CLI GEMINI_CLI_IDE_SERVER_PORT GEMINI_CLI_IDE_WORKSPACE_PATH
    OPENCODE_CLIENT CURSOR_AGENT ANTIGRAVITY_AGENT
  )
  local marker
  for marker in "${markers[@]}"; do
    [[ -n "${(P)marker:-}" ]] && return 0
  done

  [[ "${CURSOR_AGENT:-}" == true ]] && return 0

  if [[ "$terminal_program" == vscode || "$terminal_program" == cursor || "$terminal_program" == antigravity ]]; then
    local -a ide_agent_markers=(
      VSCODE_COPILOT_CHAT_TOKEN VSCODE_COPILOT_INTEGRATION_ID
      GITHUB_COPILOT_CLI_MODE
      COPILOT_AGENT_JOB_ID COPILOT_AGENT_SESSION_ID COPILOT_AGENT_PROMPT
      CODEX_SHELL CODEX_INTERNAL_ORIGINATOR_OVERRIDE
    )
    for marker in "${ide_agent_markers[@]}"; do
      [[ -n "${(P)marker:-}" ]] && return 0
    done
    [[ "${CODEX_INTERNAL_ORIGINATOR_OVERRIDE:-}" == codex_vscode* ]] && return 0
  fi

  local -a compatibility_markers=(
    AGENT_TOOL_CALLING AI_AGENT_TOOL_CALLING
    VSCODE_AGENT_TOOL_CALLING CURSOR_AGENT_TOOL_CALLING ANTIGRAVITY_AGENT_TOOL_CALLING
  )
  for marker in "${compatibility_markers[@]}"; do
    [[ -n "${(P)marker:-}" ]] && return 0
  done

  if [[ "$terminal_program" == vscode || "$terminal_program" == cursor || "$terminal_program" == antigravity ]]; then
    [[ ! -t 0 || ! -t 1 || ! -t 2 ]] && return 0
  fi
  return 1
}

if _niri_plus_is_agent_shell; then
  PROMPT='%m%# '
  RPROMPT=
  unfunction _niri_plus_is_agent_shell
  return 0
fi
unfunction _niri_plus_is_agent_shell

# Isolated test fixtures can replace only the proc/sys input roots. Normal use
# reads the ordinary Linux interfaces; absent hardware remains a hidden segment.
typeset -g NIRI_PLUS_PROC_ROOT="${NIRI_PLUS_PROC_ROOT:-/proc}"
typeset -g NIRI_PLUS_SYS_ROOT="${NIRI_PLUS_SYS_ROOT:-/sys}"

typeset -g ZSH_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
typeset -g ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/niri-plus-zsh"
mkdir -p "$ZSH_STATE_DIR" "$ZSH_CACHE_DIR"

HISTFILE="$ZSH_STATE_DIR/history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_EXPIRE_DUPS_FIRST
setopt HIST_REDUCE_BLANKS HIST_VERIFY SHARE_HISTORY EXTENDED_HISTORY

autoload -Uz compinit
compinit -d "$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

typeset -g ZSH_PLUGIN_DIR="$NIRI_PLUS_ZSH_HOME/plugins"
_niri_plus_source_if_readable() {
  [[ -r "$1" ]] && source "$1"
}

# Plugin order follows their ZLE responsibilities. Syntax highlighting loads
# last because it must wrap widgets installed by earlier integrations.
_niri_plus_source_if_readable "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
_niri_plus_source_if_readable "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh"
_niri_plus_source_if_readable "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme"

bindkey -e
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

if [[ -r "$NIRI_PLUS_ZSH_HOME/p10k.zsh" ]]; then
  source "$NIRI_PLUS_ZSH_HOME/p10k.zsh"
fi

# Optional integrations do not prevent the shell from starting when absent.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

if (( $+commands[fzf] )); then
  _niri_plus_fzf_init="$(fzf --zsh 2>/dev/null)" || _niri_plus_fzf_init=
  [[ -n "$_niri_plus_fzf_init" ]] && eval "$_niri_plus_fzf_init"
  unset _niri_plus_fzf_init
fi

# Refresh custom status while ZLE is waiting for input. Closing the read end
# makes the worker exit; the explicit print failure guard avoids a busy loop.
if [[ -o interactive ]]; then
  autoload -Uz add-zle-hook-widget add-zsh-hook
  typeset -gi __RP_REFRESH_FD=-1

  function _rp_stop_timer() {
    if (( __RP_REFRESH_FD >= 0 )); then
      zle -F "$__RP_REFRESH_FD" 2>/dev/null
      { exec {__RP_REFRESH_FD}<&-; } 2>/dev/null
      __RP_REFRESH_FD=-1
    fi
  }

  function _rp_on_tick() {
    local tick
    if ! IFS= read -r tick <&"$1"; then
      _rp_stop_timer
      return
    fi
    if (( $+functions[_p9k_set_prompt] )); then
      local _p9k__refresh_reason=precmd
      _p9k_set_prompt
    fi
    zle .reset-prompt 2>/dev/null || zle reset-prompt
  }

  function _rp_start_timer() {
    local interval="${ZSH_RIGHT_PROMPT_REFRESH_INTERVAL:-1}"
    (( __RP_REFRESH_FD >= 0 )) && return
    exec {__RP_REFRESH_FD}< <(
      while true; do
        sleep "$interval" || break
        print -r -- . || break
      done
    )
    zle -F "$__RP_REFRESH_FD" _rp_on_tick
  }

  function _rp_line_init() { _rp_start_timer }
  function _rp_line_finish() { _rp_stop_timer }

  add-zle-hook-widget -d line-init _rp_line_init 2>/dev/null
  add-zle-hook-widget -d line-finish _rp_line_finish 2>/dev/null
  add-zle-hook-widget line-init _rp_line_init
  add-zle-hook-widget line-finish _rp_line_finish
  add-zsh-hook -d zshexit _rp_stop_timer 2>/dev/null
  add-zsh-hook zshexit _rp_stop_timer
fi

_niri_plus_source_if_readable "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unfunction _niri_plus_source_if_readable
