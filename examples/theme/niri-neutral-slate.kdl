// Neutral Slate appearance only. Add the overview block to your existing Niri
// configuration. Merge the layout fragment into your existing layout block so
// current sizing, gaps, borders, shadows and behavior stay under their current owner.
overview {
    backdrop-color "#111213"
}

layout {
    background-color "#000000"

    focus-ring {
        width 4
        active-color "#a6ceff"
        inactive-color "#81878c"
    }
}
