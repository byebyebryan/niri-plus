-				return true;
-			}
+		if (has_matching_dmabuf_pair(constraints, buffer)) {
+			return true;
@@ -154,0 +163,8 @@
+		struct xdpw_buffer *buffer = cast->current_frame.xdpw_buffer;
+		if (buffer->buffer_type == DMABUF &&
+				cast->current_constraints.width == buffer->width &&
